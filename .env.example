# 复制为 .env 后填上你要用的 provider 的 key。
# key 只在真正请求该 provider 时才读取; 没用到的 provider 缺 key 不会报错。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# (ollama 无需 key)

# 可选: 覆盖默认模型, 形如 provider/model-id
# EDOCRS_MODEL=deepseek/deepseek-v4-flash

# 可选: 改配置/会话根目录 (默认 ~/.edocrs/agent)
# EDOCRS_AGENT_DIR=
